EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional garment ML hosts (auto-detected from Expo Metro when unset)
# EXPO_PUBLIC_DEV_HOST=
# EXPO_PUBLIC_API_URL=
# EXPO_PUBLIC_GARMENT_API_URL=http://192.168.1.114:8090
# EXPO_PUBLIC_GARMENT_VIA_NEST=1
# EXPO_PUBLIC_MUSE_URL=http://192.168.1.114:8787
# Brand logins are created by the Nest API (POST /brands).
# SUPABASE_SERVICE_ROLE_KEY stays in the backend .env and must not be added here.
# Ports:
#   8787 = Muse outfits (recommend / feedback / travel)
#   8090 = garment classify/cutout ML (only when saving closet photos)
#   3000 = Nest API
# Start Muse: cd closette/muse && node api/server.js --port 8787
